# --- App ---
PORT=3000
MONGODB_URI=mongodb://localhost:27017/tagme-threads

# --- Threads API (Meta) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=            # long-lived (60d), auto-refreshed by TokenRefreshService
THREADS_WEBHOOK_VERIFY_TOKEN=change-me

# --- LLM ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# --- Telegram approval bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                # chat that receives approval requests

# --- Agent behavior ---
DISCOVERY_KEYWORDS=поход Алматы,попутчики,куда сходить выходные,горы Алматы,активный отдых Казахстан
DISCOVERY_CRON=0 */4 * * *       # every 4 hours
RELEVANCE_THRESHOLD=0.7
MAX_REPLIES_PER_DAY=15
SEARCH_BUDGET_24H=2000           # hard API limit is 2,200/24h per user (across apps), keep margin
